<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The CSS host loads the API and every one of its dependencies, so none ship in the plugin. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.380" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../../shared/dotnet/**/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="lang/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
