<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/nadehud.vcss_c" />
	</styles>
	<Panel class="nh-screen" hittest="false">
		<Panel id="NadeRun" class="nh-run" hittest="false">
			<Panel class="nh-run-head" hittest="false">
				<Panel class="nh-run-titles" hittest="false">
					<Label id="kicker" class="nh-kicker" text="{s:kicker}" />
					<Label id="title" class="nh-run-title" text="{s:title}" />
				</Panel>
				<Label id="clock" class="nh-run-clock" text="{s:clock}" />
			</Panel>

			<Panel class="nh-rule" hittest="false" />

			<Panel id="steps" class="nh-run-steps" hittest="false">
				<Panel id="s1" class="nh-step" hittest="false"><Label id="st1" class="nh-step-time" text="{s:st1}" /><Panel id="sw1" class="nh-step-swatch" hittest="false" /><Label id="sn1" class="nh-step-name" text="{s:sn1}" /><Label id="sy1" class="nh-step-who" text="{s:sy1}" /></Panel>
				<Panel id="s2" class="nh-step" hittest="false"><Label id="st2" class="nh-step-time" text="{s:st2}" /><Panel id="sw2" class="nh-step-swatch" hittest="false" /><Label id="sn2" class="nh-step-name" text="{s:sn2}" /><Label id="sy2" class="nh-step-who" text="{s:sy2}" /></Panel>
